    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Conversation"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "conversation_stage_changed_trigger_sms_crm_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onConversationUpdate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onConversationUpdate"
  }
}